# Copy to /etc/juratools-mcp.env and chmod 600 — this file holds everyone's tokens.
# One token per person, so a lost laptop costs one token, not all of them.
JURATOOLS_TOKENS=korn:tok_REPLACE_ME,somchai:tok_REPLACE_ME,malee:tok_REPLACE_ME

# The name colleagues connect to. Tailscale gives you this once MagicDNS and
# HTTPS are switched on in the admin console.
PUBLIC_URL=https://homepc.YOUR-TAILNET.ts.net

# Loopback only: Tailscale is what faces the network, so nothing listens on the
# home LAN or the internet.
HOST=127.0.0.1
PORT=8787

# How long a download link stays alive.
FILE_TTL_MINUTES=30

# The office line printed on page 2 of ใบแต่งทนายความ ("สำนักงานอยู่ที่ … โทรศัพท์").
# Leave unset to print it blank; a request can still send its own.
# JURATOOLS_OFFICE_PHONE=
